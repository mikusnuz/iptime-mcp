IPTIME_ROUTER_ID=home
IPTIME_ROUTER_URL=http://192.168.0.1
IPTIME_ROUTER_USERNAME=admin
IPTIME_ROUTER_PASSWORD=

# Optional connection settings.
IPTIME_TIMEOUT_MS=12000
IPTIME_TLS_FINGERPRINT=

# Keep this false. Set it to true only when plain HTTP crosses a trusted private tunnel.
# Credentials and session cookies can be intercepted on public/DDNS HTTP connections.
IPTIME_ALLOW_INSECURE_REMOTE_HTTP=false

# Optional JSON array for multiple routers. Values ending in _env name environment variables.
# IPTIME_ROUTERS=[{"id":"home","url":"https://router.example.com","username_env":"HOME_ROUTER_USERNAME","password_env":"HOME_ROUTER_PASSWORD"}]
# HOME_ROUTER_USERNAME=admin
# HOME_ROUTER_PASSWORD=
